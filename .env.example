APP_TIMEZONE=America/Chicago
DRY_RUN=true
TEST_DATE=

SPREADSHEET_MODE=xlsx_drive

GOOGLE_SHEET_ID=
GOOGLE_SHEET_TAB=

GOOGLE_DRIVE_FILE_ID=

NAME_COLUMN=Nombre(s)
LAST_NAME_COLUMN=Apellidos
GENDER_COLUMN=Género
EMAIL_COLUMN=Correo electrónico
BIRTHDAY_COLUMN=Fecha de nacimiento
LAST_SENT_YEAR_COLUMN=Last Birthday Email Year

EMAIL_PROVIDER=gmail
EMAIL_FROM_NAME=
EMAIL_FROM_ADDRESS=
EMAIL_SUBJECT_TEMPLATE=Happy Birthday, {{name}}! 🎉

# GOOGLE_AUTH_MODE selects how the app authenticates to Google APIs:
#   service_account (default) - non-interactive, used for deployment.
#   oauth                     - interactive user consent, for local testing only.
GOOGLE_AUTH_MODE=service_account

# Required when GOOGLE_AUTH_MODE=service_account.
GOOGLE_CREDENTIALS_FILE=
GOOGLE_IMPERSONATE_SUBJECT=

# Required when GOOGLE_AUTH_MODE=oauth (OAuth client ID JSON, "Desktop app"
# type, downloaded from Google Cloud Console). Not used in service_account mode.
GOOGLE_OAUTH_CLIENT_SECRETS_FILE=
# Where the authorized user token is cached after the first interactive
# consent. Relative paths are resolved from the project root.
GOOGLE_OAUTH_TOKEN_FILE=data/google_oauth_token.json

BIRTHDAY_IMAGE_MODE=local
BIRTHDAY_IMAGE_PATH=app/assets/birthday_banner.jpg
BIRTHDAY_IMAGE_URL=
BIRTHDAY_IMAGE_ALT=Happy Birthday
BIRTHDAY_IMAGE_WIDTH=600

STATE_BACKEND=sqlite
# Relative paths are resolved from the project root, not the current working directory.
# Used only when STATE_BACKEND=sqlite.
STATE_DB_PATH=data/birthday_state.db
STALE_CLAIM_TIMEOUT_MINUTES=30

RETRY_MAX_ATTEMPTS=3
RETRY_BASE_DELAY_SECONDS=1.0

LOG_LEVEL=INFO
